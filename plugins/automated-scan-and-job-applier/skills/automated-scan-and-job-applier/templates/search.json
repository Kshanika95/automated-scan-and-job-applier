{
  "_help": "What to look for. Title tracks are regular expressions matched against lower-cased job titles. A job is queued when it matches a track, isn't excluded, and its location fits. The fit check then decides with min_fit (0-10). See references/setup.md.",
  "tracks": [
    {
      "name": "core",
      "priority": 1,
      "min_fit": 6,
      "title_regex": "\\b(ux|user|design|product|experience|mixed[- ]methods?|qualitative|quantitative)\\b.*research|research(er)?\\b.*\\b(ux|user experience)\\b|research ?ops|research operations"
    },
    {
      "name": "adjacent-design",
      "priority": 3,
      "min_fit": 7,
      "title_regex": "\\b(ux|ui|product|experience|interaction|service)\\b.*designer|design strategist|conversation(al)? designer"
    },
    {
      "name": "adjacent-pm",
      "priority": 4,
      "min_fit": 8,
      "title_regex": "(product|program) manager",
      "title_must_also_match": "(research|ux|user experience|design|insight)"
    }
  ],
  "exclude_title_regex": "\\b(intern|internship|new grad|junior|engineers?|attorney|counsel|nurse|director|vice president|vp|head of|chief)\\b",
  "locations": {
    "onsite_keywords": [
      "austin",
      "round rock",
      "cedar park"
    ],
    "remote": true,
